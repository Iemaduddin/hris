    {
      "name": "Approval",
      "item": [
        {
          "name": "Inbox Saya",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/approval",
            "description": "Untuk atasan langsung (timnya) dan HR (semua). Karyawan biasa: count 0."
          }
        },
        {
          "name": "Setujui",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/approval",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CUTI\",\n  \"id\": \"PASTE_ID_PENGAJUAN\",\n  \"keputusan\": \"SETUJU\",\n  \"catatan\": \"OK\"\n}"
            },
            "description": "type: CUTI | LEMBUR | DINAS. keputusan: SETUJU | TOLAK."
          }
        },
        {
          "name": "Tolak",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/approval",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CUTI\",\n  \"id\": \"PASTE_ID_PENGAJUAN\",\n  \"keputusan\": \"TOLAK\",\n  \"catatan\": \"Stok tim menipis\"\n}"
            }
