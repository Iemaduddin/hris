    {
      "name": "Slip dan Jadwal",
      "item": [
        {
          "name": "Daftar Slip Saya",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/payslip",
            "description": "Hanya slip yang sudah DITERBITKAN."
          }
        },
        {
          "name": "Detail Slip",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payslip?nomor=SLIP-2026-10-XXXXXX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payslip"
              ],
              "query": [
                {
                  "key": "nomor",
                  "value": "SLIP-2026-10-XXXXXX"
                }
              ]
            }
          }
        },
        {
          "name": "Jadwal Saya",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedule?mulai=2026-10-01&selesai=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schedule"
              ],
              "query": [
                {
                  "key": "mulai",
                  "value": "2026-10-01"
                },
                {
                  "key": "selesai",
                  "value": "2026-10-31"
                }
              ]
            },
            "description": "Roster shift + penugasan kalender. Default 7 hari ke depan bila tanpa query."
          }
        }
      ]
    },
    {
      "name": "File",
      "item": [
        {
          "name": "Upload Lampiran",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/files",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "ownerType",
                  "value": "pengajuan",
                  "type": "text"
                },
                {
                  "key": "ownerId",
                  "value": "KARYAWAN_ID",
                  "type": "text"
                },
                {
                  "key": "subfolder",
                  "value": "lampiran",
                  "type": "text"
                },
                {
                  "key": "jenis",
                  "value": "lampiran",
                  "type": "text"
                }
              ]
            },
            "description": "Respons berisi path + url. Pakai path sebagai lampiran pengajuan. ownerType: pengajuan (umum), karyawan (khusus HR)."
          }
        }
      ]
    },
