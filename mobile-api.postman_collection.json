        },
        {
          "name": "Daftar Pengajuan Saya",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/leave"
          }
        },
        {
          "name": "Buat Draf",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/leave",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jenisId\": 1,\n  \"mulai\": \"2026-11-02\",\n  \"selesai\": \"2026-11-03\",\n  \"alasan\": \"Keperluan keluarga\",\n  \"alamat\": \"Rumah\",\n  \"telpDarurat\": \"0812000000\",\n  \"lampiran\": \"\"\n}"
            },
            "description": "Ambil jenisId dari endpoint Jenis Aktif. lampiran = path dari hasil upload file (cth. pengajuan/.../file.pdf)."
          }
        },
        {
          "name": "Ajukan Draf",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/leave",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"PASTE_ID_DRAF\",\n  \"aksi\": \"ajukan\"\n}"
            },
            "description": "aksi: ajukan | batal."
          }
        }
      ]
