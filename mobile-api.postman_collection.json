              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"KELUAR\",\n  \"deviceId\": \"android-abc123\",\n  \"latitude\": -6.2,\n  \"longitude\": 106.8\n}"
            }
          }
        },
        {
          "name": "Status Hari Ini",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/attendance"
          }
        },
        {
          "name": "Riwayat Bulanan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/history?year=2026&month=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "history"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
