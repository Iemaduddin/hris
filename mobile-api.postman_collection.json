            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"MASUK\",\n  \"deviceId\": \"android-abc123\",\n  \"latitude\": -6.2,\n  \"longitude\": 106.8,\n  \"workLocationId\": \"\",\n  \"note\": \"\"\n}"
            },
            "description": "eventType: MASUK, KELUAR, MULAI_ISTIRAHAT, SELESAI_ISTIRAHAT, KELUAR_KANTOR, KEMBALI_KANTOR. latitude/longitude opsional."
          }
        },
        {
          "name": "Clock Out",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/attendance",
            "header": [
              {
                "key": "Content-Type",
