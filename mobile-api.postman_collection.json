{
  "info": {
    "name": "HRIS Mobile API",
    "description": "Koleksi endpoint mobile HRIS (/api/v1 + upload file). Cara pakai:\n1. Import file ini ke Postman.\n2. Isi variable baseUrl (cth. http://localhost:3000).\n3. Jalankan request \"Login\" lebih dulu — cookie sesi tersimpan otomatis di cookie jar Postman.\n4. Akun harus sudah ditautkan ke data karyawan oleh HR, kalau tidak endpoint ESS membalas 403.\n\nEnvelope sukses: { success: true, data: ... }. Gagal: { success: false, error: ... }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@example.com\",\n  \"password\": \"Employee123!\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Saya (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/me"
          }
        }
      ]
    },
    {
      "name": "Presensi",
      "item": [
        {
          "name": "Clock In",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/attendance",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipe\": \"MASUK\",\n  \"deviceId\": \"android-abc123\",\n  \"latitude\": -6.2,\n  \"longitude\": 106.8,\n  \"lokasiKerjaId\": \"\",\n  \"catatan\": \"\"\n}"
            },
            "description": "tipe: MASUK, KELUAR, MULAI_ISTIRAHAT, SELESAI_ISTIRAHAT, KELUAR_KANTOR, KEMBALI_KANTOR. latitude/longitude opsional."
          }
        },
        {
          "name": "Clock Out",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/attendance",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipe\": \"KELUAR\",\n  \"deviceId\": \"android-abc123\",\n  \"latitude\": -6.2,\n  \"longitude\": 106.8\n}"
            }
          }
        },
        {
          "name": "Status Hari Ini",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/attendance"
          }
        },
        {
          "name": "Riwayat Bulanan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/history?tahun=2026&bulan=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "history"
              ],
              "query": [
                {
                  "key": "tahun",
                  "value": "2026"
                },
                {
                  "key": "bulan",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cuti",
