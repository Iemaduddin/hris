generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// BETTER AUTH — Core tables
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          UserRole @default(EMPLOYEE)
  // Nonaktif = tak bisa login (offboarding selesai / dinonaktifkan HR).
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  karyawan Karyawan[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_HR
  MANAJER
  FINANCE
  EMPLOYEE
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================================
// MASTER DATA WILAYAH
// ============================================================

model Provinsi {
  id   String @id
  nama String

  kota Kota[]

  @@map("provinsi")
}

model Kota {
  id         String   @id
  provinsiId String
  nama       String
  provinsi   Provinsi @relation(fields: [provinsiId], references: [id], onDelete: Cascade)

  kecamatan Kecamatan[]

  @@index([provinsiId])
  @@map("kota")
}

model Kecamatan {
  id     String @id
  kotaId String
  nama   String
  kota   Kota   @relation(fields: [kotaId], references: [id], onDelete: Cascade)

  desa Desa[]

  @@index([kotaId])
  @@map("kecamatan")
}

model Desa {
  id          String    @id
  kecamatanId String
  nama        String
  kecamatan   Kecamatan @relation(fields: [kecamatanId], references: [id], onDelete: Cascade)

  @@index([kecamatanId])
  @@map("desa")
}

// ============================================================
// COMPANY — profil perusahaan
// ============================================================

model Perusahaan {
  id          String   @id @default(cuid())
  nama        String
  logo        String?
  npwp        String?
  telepon     String?
  email       String?
  website     String?
  provinsiId  String?
  kotaId      String?
  kecamatanId String?
  desaId      String?
  alamat      String?
  kodePos     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("perusahaan")
}

// ============================================================
// UNIT ORGANISASI — struktur unit kerja yang sederhana
// ============================================================

model UnitOrganisasi {
  id       String           @id @default(cuid())
  parentId String?
  parent   UnitOrganisasi?  @relation("UnitTree", fields: [parentId], references: [id])
  children UnitOrganisasi[] @relation("UnitTree")

  nama      String
  kode      String?
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisi         Posisi[]
  posisiKaryawan PosisiKaryawan[]
  mutasiKeUnit   Mutasi[]

  @@index([parentId])
  @@map("unit_organisasi")
}

// ============================================================
// GOLONGAN POSISI — grade posisi
// ============================================================

model GolonganPosisi {
  id        String   @id @default(cuid())
  nama      String
  kode      String?  @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisi Posisi[]

  @@map("golongan_posisi")
}

// ============================================================
// POSISI
// ============================================================

model Posisi {
  id                String           @id @default(cuid())
  unitOrganisasiId  String?
  unitOrganisasi    UnitOrganisasi?  @relation(fields: [unitOrganisasiId], references: [id])
  golonganPosisiId String?
  golonganPosisi   GolonganPosisi? @relation(fields: [golonganPosisiId], references: [id])

  nama      String
  kode      String?  @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisiKaryawan PosisiKaryawan[]
  mutasiKePosisi Mutasi[]

  @@map("posisi")
}

// ============================================================
// LOKASI KERJA — cabang / kantor / lokasi kerja
// ============================================================

model LokasiKerja {
  id        String   @id @default(cuid())
  nama      String
  kode      String?
  alamat    String?
  kota      String?
  provinsi  String?
  kodePos   String?
  // PRD mobile Bag. 5.4 / B2 — titik pusat lokasi & radius validasi presensi.
  // radiusMeter null = lokasi tidak divalidasi radius (absensi tetap dicatat tanpa flag).
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  radiusMeter Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisiKaryawan PosisiKaryawan[]
  absensi        Absensi[]
  mutasiKeLokasi Mutasi[]

  @@map("lokasi_kerja")
}

// ============================================================
// KARYAWAN — Data utama karyawan
// ============================================================

model Karyawan {
  id            String  @id @default(cuid())
  userId        String? @unique
  user          User?   @relation(fields: [userId], references: [id])
  atasanLangsungId String?
  atasanLangsung   Karyawan?  @relation("AtasanBawahan", fields: [atasanLangsungId], references: [id], onDelete: SetNull)
  bawahan          Karyawan[] @relation("AtasanBawahan")
  nomorKaryawan String

  namaLengkap  String
  gender       JenisKelamin
  tanggalLahir DateTime?
  nik          String?  @unique
  npwp         String?
  telepon      String?
  email        String?
  alamat       String?

  // Rekening untuk disbursement gaji/THR.
  bankNama     String?
  bankNorek    String?
  bankAtasNama String?

  status         StatusKaryawan @default(AKTIF)
  // Status PTKP penentu kategori TER A/B/C (PP 58/2023).
  statusPtkp     StatusPtkp     @default(TK_0)
  tanggalMasuk   DateTime
  tanggalResign  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kontrakKerja       KontrakKerja[]
  posisiKaryawan    PosisiKaryawan[]
  rosterShift       RosterShift[]
  penugasanKalender PenugasanKalender[]
  rekapHarian       RekapHarian[]
  dinasWfh          DinasWFH[]
  gajiKaryawan      GajiKaryawan[]
  salaryRunDetail   SalaryRunDetail[]
  payslip           Payslip[]
  thrDetail         ThrDetail[]
  kasbon            Kasbon[]
  mutasi            Mutasi[]
  mutasiBaruAtasan  Mutasi[]           @relation("MutasiAtasanBaru")
  onboarding        Onboarding[]
  offboarding       Offboarding[]
  probationReviews  ProbationReview[]
  suratPeringatan   SuratPeringatan[]
  keluargaKaryawan   KeluargaKaryawan[]
  pendidikanKaryawan PendidikanKaryawan[]
  riwayatPekerjaan   RiwayatPekerjaan[]
  dokumenKaryawan    DokumenKaryawan[]
  Absensi            Absensi[]
  perangkat          PerangkatKaryawan[]
  saldoCuti     SaldoCuti[]
  pengajuanCuti PengajuanKetidakhadiran[]
  penugasanJadwal PenugasanJadwal[]
  lembur         Lembur[]

  @@unique([nomorKaryawan])
  @@index([status])
  @@map("karyawan")
}

// ============================================================
// KONTRAK KERJA — Histori hubungan kerja employee
// ============================================================

model KontrakKerja {
  id         String   @id @default(cuid())
  karyawanId String
  karyawan   Karyawan @relation(fields: [karyawanId],references: [id], onDelete: Cascade)
  nomorKontrak String       @unique
  jenisKontrak JenisKontrak
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  status StatusKontrak @default(DRAFT)
  gajiPokok Decimal? @db.Decimal(15, 2)
  catatan    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tandaTangan KontrakTandaTangan[]

  @@index([karyawanId])
  @@index([karyawanId, status])
  @@index([tanggalMulai])
  @@index([tanggalSelesai])

  @@map("kontrak_kerja")
}


// ============================================================
// ENUM — JENIS KONTRAK
// ============================================================

enum JenisKontrak {
  PKWT
  PKWTT
  MAGANG
  FREELANCE
  OUTSOURCING
}


// ============================================================
// ENUM — STATUS KONTRAK
// ============================================================

enum StatusKontrak {
  DRAFT
  AKTIF
  AKAN_BERAKHIR
  BERAKHIR
  DIBATALKAN
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusKaryawan {
  AKTIF
  TIDAK_AKTIF
  PROBASI
  RESIGN
  DIHENTIKAN
  PENSIUN
}

// Status PTKP (PP 58/2023). Nama enum tanpa "/" agar valid Prisma.
// Label tampilan: TK_0 -> "TK/0", dst.
enum StatusPtkp {
  TK_0
  TK_1
  TK_2
  TK_3
  K_0
  K_1
  K_2
  K_3
}



// ============================================================
// POSISI KARYAWAN — riwayat posisi yang pernah/terpilih
// ============================================================

model PosisiKaryawan {
  id               String          @id @default(cuid())
  karyawanId       String
  karyawan         Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  unitOrganisasiId String?
  unitOrganisasi   UnitOrganisasi? @relation(fields: [unitOrganisasiId], references: [id])
  posisiId        String?
  posisi          Posisi?        @relation(fields: [posisiId], references: [id])
  lokasiKerjaId    String?
  lokasiKerja      LokasiKerja?    @relation(fields: [lokasiKerjaId], references: [id])

  isPrimary       Boolean   @default(true)
  isCurrent       Boolean   @default(true)
  tanggalEfektif  DateTime
  tanggalBerakhir DateTime?
  catatan         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([karyawanId, isCurrent])
  @@map("posisi_karyawan")
}

// ============================================================
// KELUARGA KARYAWAN — Data keluarga & ahli waris
// ============================================================

model KeluargaKaryawan {
  id           String           @id @default(cuid())
  karyawanId   String
  karyawan     Karyawan         @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  nama         String
  hubungan     HubunganKeluarga
  gender       JenisKelamin
  tanggalLahir DateTime?
  nik          String?
  pekerjaan    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("keluarga_karyawan")
}

enum HubunganKeluarga {
  PASANGAN
  ANAK
  ORANG_TUA
  SAUDARA
  LAINNYA
}

// ============================================================
// PENDIDIKAN KARYAWAN
// ============================================================

model PendidikanKaryawan {
  id          String          @id @default(cuid())
  karyawanId  String
  karyawan    Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  gelar       GelarPendidikan
  institusi   String
  jurusan     String?
  tahunMulai  Int?
  tahunLulus  Int?
  ipk         Float?
  isHighest   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("pendidikan_karyawan")
}

enum GelarPendidikan {
  SD
  SMP
  SMA_SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
  LAINNYA
}

// ============================================================
// RIWAYAT PEKERJAAN — Riwayat pekerjaan sebelumnya
// ============================================================

model RiwayatPekerjaan {
  id               String    @id @default(cuid())
  karyawanId       String
  karyawan         Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  namaPerusahaan   String
  posisi          String?
  tanggalMulai     DateTime?
  tanggalSelesai   DateTime?
  gajiTerakhir     Decimal?  @db.Decimal(15, 2)
  alasanKeluar     String?
  teleponReferensi String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("riwayat_pekerjaan")
}

// ============================================================
// DOKUMEN KARYAWAN
// ============================================================

model DokumenKaryawan {
  id                String       @id @default(cuid())
  karyawanId        String
  karyawan          Karyawan     @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  jenisDokumen      JenisDokumen
  nama              String
  urlFile           String
  ukuranFile        BigInt?
  tipeFile          String?
  tanggalKadaluarsa DateTime?
  catatan           String?
  tanggalUnggah     DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("dokumen_karyawan")
}

enum JenisDokumen {
  KTP
  NPWP
  IJAZAH
  TRANSKRIP
  PAKLARING
  SERTIFIKAT
  KONTRAK_KERJA
  FOTO
  KARTU_KELUARGA
  BPJS_KESEHATAN
  BPJS_KETENAGAKERJAAN
  CV
  LAINNYA
}

// ============================================================
// ATTENDANCE EVENT
// ============================================================

model Absensi {
  id String @id @default(cuid())
  karyawanId String
  karyawan   Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  waktu DateTime
  tipe TipeAbsensi
  sumber SumberAbsensi
  deviceId String?
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  // PRD mobile Bag. 5.4 — hasil validasi lokasi. null = tidak divalidasi
  // (tanpa GPS, atau lokasi kerja belum mengatur radius).
  diLuarRadius Boolean?
  // PRD mobile Bag. 5.4 — deteksi GPS simulasi/placeholder di perangkat.
  isMocked     Boolean  @default(false)
  lokasiKerjaId String?
  lokasiKerja   LokasiKerja? @relation(fields: [lokasiKerjaId], references: [id])
  status StatusAbsensi @default(VALID)
  catatan String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([karyawanId, waktu])
  @@index([waktu])
  @@index([karyawanId, tipe, waktu])
  @@map("absensi")
}

enum TipeAbsensi {
  MASUK
  KELUAR

  MULAI_ISTIRAHAT
  SELESAI_ISTIRAHAT

  KELUAR_KANTOR
  KEMBALI_KANTOR
}

enum SumberAbsensi {
  RFID
  FINGERPRINT
  QR_CODE
  WEB
  MOBILE
  API
  MANUAL
}

enum StatusAbsensi {
  VALID
  INVALID
  DIKOREKSI
  DIBATALKAN
}

// ============================================================
// PERANGKAT KARYAWAN — registrasi device mobile (PRD mobile Bag. 7-B5)
// Dipakai untuk audit device presensi & nantinya token push (Bag. 7-B8).
// ============================================================

model PerangkatKaryawan {
  id           String    @id @default(cuid())
  karyawanId   String
  karyawan     Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  deviceId     String
  namaPerangkat String?
  platform     String?
  // Diisi pada Tahap M4 (PRD mobile Bag. 7-B8).
  pushToken    String?
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([karyawanId, deviceId])
  @@index([karyawanId, isActive])
  @@map("perangkat_karyawan")
}

// ============================================================
// LEMBUR — Pencatatan jam lembur karyawan
// ============================================================

model Lembur {
  id              String        @id @default(cuid())
  karyawanId      String
  karyawan        Karyawan      @relation(fields: [karyawanId], references: [id], onDelete: Cascade)

  tanggal         DateTime
  jamMulai        DateTime? @db.Time()
  jamSelesai      DateTime? @db.Time()
  jumlahJam       Decimal       @db.Decimal(4, 2)

  alasan          String
  status          StatusLembur  @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  catatan         String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([karyawanId, tanggal])
  @@index([status])
  @@map("lembur")
}

model JenisKetidakhadiran {
  id          Int  @id @default(autoincrement())
  kode        String  @unique
  nama        String
  kategori    KategoriKetidakhadiran
  deskripsi   String?

  // Apakah menggunakan saldo cuti?
  menggunakanSaldo Boolean @default(false)

  // Digunakan hanya jika menggunakanSaldo = true
  jatahTahunan Decimal? @db.Decimal(5, 2)

  // Apakah wajib upload dokumen?
  wajibLampiran Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saldoCuti                 SaldoCuti[]
  pengajuanKetidakhadiran  PengajuanKetidakhadiran[]

  @@map("jenis_ketidakhadiran")
}


enum KategoriKetidakhadiran {
  CUTI
  IZIN
}

model SaldoCuti {
  id Int @id @default(autoincrement())

  karyawanId String
  karyawan   Karyawan @relation(fields: [karyawanId],references: [id],onDelete: Cascade)

  jenisKetidakhadiranId Int
  jenisKetidakhadiran   JenisKetidakhadiran @relation(fields: [jenisKetidakhadiranId],references: [id])

  tahun Int

  saldoAwal  Decimal @db.Decimal(5, 2)
  saldoAkhir Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mutasiSaldoCuti MutasiSaldoCuti[]

  @@unique([karyawanId, jenisKetidakhadiranId, tahun])
  @@index([karyawanId])
  @@index([tahun])

  @@map("saldo_cuti")
}

model MutasiSaldoCuti {
  id Int @id @default(autoincrement())

  saldoCutiId Int
  saldoCuti   SaldoCuti @relation(fields: [saldoCutiId],references: [id],onDelete: Cascade)

  tipe TipeMutasiSaldo
  jumlah Decimal @db.Decimal(5, 2)

  referensiId String?
  keterangan  String?

  createdAt DateTime @default(now())

  @@index([saldoCutiId, createdAt])
  @@map("mutasi_saldo_cuti")
}

enum TipeMutasiSaldo {
  PENAMBAHAN
  PENGURANGAN
  PENYESUAIAN
  KADALUARSA
}

model PengajuanKetidakhadiran {
  id String @id @default(cuid())

  nomorPengajuan String @unique

  karyawanId String
  karyawan   Karyawan @relation(fields: [karyawanId],references: [id])

  jenisKetidakhadiranId Int
  jenisKetidakhadiran   JenisKetidakhadiran @relation(fields: [jenisKetidakhadiranId],references: [id])

  // ----------------------------------------------------------
  // PERIODE
  // ----------------------------------------------------------

  tanggalMulai   DateTime
  tanggalSelesai DateTime

  jumlahHari Decimal @db.Decimal(5, 2)

  // ----------------------------------------------------------
  // INFORMASI PENGAJUAN
  // ----------------------------------------------------------

  alasan String?

  alamatSelamaTidakHadir String?

  nomorTeleponDarurat String?

  // ----------------------------------------------------------
  // LAMPIRAN
  // ----------------------------------------------------------

  urlLampiran String?

  // ----------------------------------------------------------
  // STATUS
  // ----------------------------------------------------------

  status StatusPengajuanKetidakhadiran @default(DRAFT)

  diajukanPada DateTime?

  approvedById String?
  approvedAt   DateTime?
  approvedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([karyawanId, tanggalMulai])
  @@index([jenisKetidakhadiranId])
  @@index([status])

  @@map("pengajuan_ketidakhadiran")
}

enum StatusPengajuanKetidakhadiran {
  DRAFT
  DIAJUKAN
  MENUNGGU_APPROVAL
  DISETUJUI
  DITOLAK
  DIBATALKAN
  SELESAI
}

enum StatusLembur {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
}


model KalenderKerja {
  id Int @id @default(autoincrement())

  nama       String
  kode       String? @unique
  deskripsi  String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jadwalKerja JadwalKerja[]
  hariLibur   HariLibur[]
  penugasanKalender PenugasanKalender[]

  @@map("kalender_kerja")
}

model JadwalKerja {
  id Int @id @default(autoincrement())

  kalenderKerjaId Int
  kalenderKerja   KalenderKerja @relation(fields: [kalenderKerjaId],references: [id],onDelete: Cascade)

  hari HariDalamMinggu

  isHariKerja Boolean @default(true)

  jamMasuk DateTime? @db.Time()
  jamKeluar DateTime? @db.Time()

  jamMulaiIstirahat DateTime? @db.Time()
  jamSelesaiIstirahat DateTime? @db.Time()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  penugasanJadwal PenugasanJadwal[]

  @@unique([kalenderKerjaId, hari])
  @@map("jadwal_kerja")
}

enum HariDalamMinggu {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

model HariLibur {
  id Int @id @default(autoincrement())

  kalenderKerjaId Int
  kalenderKerja   KalenderKerja @relation(fields: [kalenderKerjaId],references: [id],onDelete: Cascade)

  tanggal DateTime

  nama        String
  deskripsi   String?
  isCutiBersama Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kalenderKerjaId, tanggal])
  @@index([tanggal])
  @@map("hari_libur")
}

// ============================================================
// FILE ASSET — metadata berkas penyimpanan lokal
// ============================================================

model FileAsset {
  id           String   @id @default(cuid())
  ownerType    String
  ownerId      String
  jenis        String?
  path         String   @unique
  mime         String?
  size         BigInt?
  hash         String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("file_asset")
}

// ============================================================
// PENOMORAN — sequence aman-konkuren untuk nomor karyawan
// ============================================================

model Penomoran {
  id        String   @id @default(cuid())
  kunci     String   @unique
  terakhir  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("penomoran")
}

// ============================================================
// SHIFT & ROSTER — pola kerja bergilir / malam
// ============================================================

model Shift {
  id                 String   @id @default(cuid())
  kode               String   @unique
  nama               String
  jamMasuk           DateTime @db.Time()
  jamKeluar          DateTime @db.Time()
  lintasHari         Boolean  @default(false)
  toleransiTelatMenit Int     @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roster RosterShift[]

  @@map("shift")
}

model RosterShift {
  id         Int      @id @default(autoincrement())
  karyawanId String
  karyawan   Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  tanggal    DateTime @db.Date
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([karyawanId, tanggal])
  @@index([tanggal])
  @@map("roster_shift")
}

model PenugasanKalender {
  id              Int           @id @default(autoincrement())
  karyawanId      String
  karyawan        Karyawan      @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  kalenderKerjaId Int
  kalenderKerja   KalenderKerja @relation(fields: [kalenderKerjaId], references: [id], onDelete: Restrict)
  tanggalMulai    DateTime      @db.Date
  tanggalSelesai  DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([karyawanId])
  @@map("penugasan_kalender")
}

// ============================================================
// REKAP HARIAN — snapshot hasil mesin rekap kehadiran
// ============================================================

model RekapHarian {
  id                   Int      @id @default(autoincrement())
  karyawanId           String
  karyawan             Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  tanggal              DateTime @db.Date
  sumberJadwal         String
  acuanId              String?
  jamMasukSeharusnya    DateTime? @db.Time()
  jamKeluarSeharusnya   DateTime? @db.Time()
  masukAktual          DateTime?
  keluarAktual         DateTime?
  telatMenit           Int       @default(0)
  pulangCepatMenit     Int       @default(0)
  lemburMenit          Int       @default(0)
  status               StatusRekap
  dihitungPada         DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([karyawanId, tanggal])
  @@index([tanggal])
  @@map("rekap_harian")
}

enum StatusRekap {
  HADIR
  TERLAMBAT
  ALPA
  CUTI
  IZIN
  SAKIT
  DINAS
  LIBUR
}

// ============================================================
// PAYROLL — komponen, salary run, payslip
// ============================================================

model KomponenGaji {
  id        String            @id @default(cuid())
  kode      String            @unique
  nama      String
  kelompok  KelompokKomponen
  tipe      TipeKomponen
  nilai     Decimal           @db.Decimal(15, 2)
  batasAtas Decimal?          @db.Decimal(15, 2)
  isActive  Boolean           @default(true)
  urutan    Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  gajiKaryawan GajiKaryawan[]

  @@map("komponen_gaji")
}

enum KelompokKomponen {
  PENDAPATAN
  TUNJANGAN
  POTONGAN
  IURAN
  // Premi ditanggung perusahaan; info slip, tak mengurangi gaji bersih.
  BIAYA_PERUSAHAAN
}

enum TipeKomponen {
  NOMINAL
  PERSEN
  PER_HARI
  PER_JAM_LEMBUR
  PER_SHIFT_MALAM
}

// ============================================================
// Tarif efektif bulanan PPh 21 (PP 58/2023 + PMK 168/2023)
// Satu baris = satu lapis: bruto <= batasAtas dikenai tarif.
// batasAtas null = lapis terakhir (tak hingga).
// Di-seed dari prisma/seed-pph21-ter.ts; dapat diubah Finance bila regulasi berubah.
// ============================================================

model Pph21TerTarif {
  id        Int      @id @default(autoincrement())
  kategori  String
  batasAtas Decimal? @db.Decimal(15, 2)
  tarif     Decimal  @db.Decimal(6, 4)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kategori, urutan])
  @@index([kategori, urutan])
  @@map("pph21_ter_tarif")
}

// ============================================================
// Pengaturan payroll key-value. Default di lib; DB hanya override.
// ============================================================

model PayrollSetting {
  kunci     String   @id
  nilai     String
  deskripsi String?
  updatedAt DateTime @updatedAt

  @@map("payroll_setting")
}

model GajiKaryawan {
  id          String       @id @default(cuid())
  karyawanId  String
  karyawan    Karyawan     @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  komponenId  String
  komponen    KomponenGaji @relation(fields: [komponenId], references: [id], onDelete: Restrict)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([karyawanId, komponenId])
  @@map("gaji_karyawan")
}

model SalaryRun {
  id             String          @id @default(cuid())
  periode        String          @unique
  tanggalMulai   DateTime        @db.Date
  tanggalSelesai DateTime        @db.Date
  status         StatusSalaryRun @default(DRAF)
  catatan        String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  detail  SalaryRunDetail[]
  payslip Payslip[]
  angsuranKasbon KasbonAngsuran[]

  @@map("salary_run")
}

enum StatusSalaryRun {
  DRAF
  DIHITUNG
  FINAL
  DITERBITKAN
}

model SalaryRunDetail {
  id               String    @id @default(cuid())
  runId            String
  run              SalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  karyawanId       String
  karyawan         Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  gajiPokok        Decimal   @db.Decimal(15, 2)
  totalPendapatan  Decimal   @db.Decimal(15, 2)
  totalPotongan    Decimal   @db.Decimal(15, 2)
  gajiBersih       Decimal   @db.Decimal(15, 2)
  // Total premi ditanggung perusahaan (info, tak memengaruhi bersih).
  totalBiayaPerusahaan Decimal @db.Decimal(15, 2) @default(0)
  hariHadir        Int       @default(0)
  hariAlpa         Int       @default(0)
  jamLembur        Decimal   @db.Decimal(6, 2) @default(0)
  rincian          Json
  createdAt        DateTime  @default(now())

  @@unique([runId, karyawanId])
  @@map("salary_run_detail")
}

// ============================================================
// THR Keagamaan (Permenaker 6/2016). Run dan slip terpisah dari gaji.
// ≥12 bulan → 1x upah (gapok + tunjangan tetap); <12 bulan → prorata.
// ============================================================

model ThrRun {
  id              String          @id @default(cuid())
  tahun           Int
  namaHariRaya    String
  tanggalHariRaya DateTime        @db.Date
  tanggalBayar    DateTime        @db.Date
  status          StatusSalaryRun @default(DRAF)
  catatan         String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  detail ThrDetail[]

  @@unique([tahun, namaHariRaya])
  @@index([tahun])
  @@map("thr_run")
}

model ThrDetail {
  id             String   @id @default(cuid())
  nomor          String   @unique
  runId          String
  run            ThrRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  karyawanId     String
  karyawan       Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  masaKerjaBulan Int      @default(0)
  upahSebulan    Decimal  @db.Decimal(15, 2)
  bruto          Decimal  @db.Decimal(15, 2)
  pph21          Decimal  @db.Decimal(15, 2) @default(0)
  bersih         Decimal  @db.Decimal(15, 2)
  rincian        Json
  // Kode verifikasi slip PDF (diisi saat terbit/unduh pertama).
  kodeVerifikasi String?  @unique
  createdAt      DateTime @default(now())

  @@unique([runId, karyawanId])
  @@index([karyawanId])
  @@map("thr_detail")
}

// ============================================================
// Mutasi / promosi / demosi. Workflow: DRAFT → DIAJUKAN →
// MENUNGGU_APPROVAL (atasan → HR) → DISETUJUI → DITERAPKAN.
// Penerapan append-only: tutup penempatan aktif + buka record baru.
// ============================================================

model Mutasi {
  id           String       @id @default(cuid())
  nomor        String       @unique
  karyawanId   String
  karyawan     Karyawan     @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  jenis        JenisMutasi
  dariUnitId   String?
  dariPosisiId String?
  dariLokasiId String?
  dariUnitNama   String?
  dariPosisiNama String?
  dariLokasiNama String?
  keUnitId     String?
  keUnit       UnitOrganisasi? @relation(fields: [keUnitId], references: [id], onDelete: SetNull)
  kePosisiId   String?
  kePosisi     Posisi?         @relation(fields: [kePosisiId], references: [id], onDelete: SetNull)
  keLokasiId   String?
  keLokasi     LokasiKerja?    @relation(fields: [keLokasiId], references: [id], onDelete: SetNull)
  keAtasanId   String?
  keAtasan     Karyawan?       @relation("MutasiAtasanBaru", fields: [keAtasanId], references: [id], onDelete: SetNull)
  tanggalEfektif DateTime    @db.Date
  alasan         String
  status         StatusMutasi @default(DRAFT)
  diajukanPada   DateTime?
  approvedById   String?
  approvedAt     DateTime?
  approvedNote   String?
  diterapkanPada DateTime?
  diterapkanOlehId String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([karyawanId, status])
  @@map("mutasi")
}

enum JenisMutasi {
  MUTASI
  PROMOSI
  DEMOSI
}

enum StatusMutasi {
  DRAFT
  DIAJUKAN
  MENUNGGU_APPROVAL
  DISETUJUI
  DITOLAK
  DITERAPKAN
  DIBATALKAN
}

// ============================================================
// Onboarding karyawan baru / pindah (P1-2).
// Template per jenis kontrak → disalin jadi checklist per karyawan.
// Alur item: BELUM → SELESAI (dicentang karyawan) → TERVERIFIKASI
// (atasan/HR). Onboarding SELESAI bila semua item wajib terverifikasi.
// ============================================================

model OnboardingTemplate {
  id           String         @id @default(cuid())
  nama         String
  jenisKontrak JenisKontrak?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items OnboardingTemplateItem[]

  @@map("onboarding_template")
}

model OnboardingTemplateItem {
  id         String               @id @default(cuid())
  templateId String
  template   OnboardingTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  judul      String
  deskripsi  String?
  kategori   KategoriOnboarding   @default(LAINNYA)
  wajib      Boolean              @default(true)
  urutan     Int                  @default(0)

  @@index([templateId, urutan])
  @@map("onboarding_template_item")
}

model Onboarding {
  id            String            @id @default(cuid())
  karyawanId    String
  karyawan      Karyawan          @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  templateId    String?
  templateNama  String?
  status        StatusOnboarding  @default(BERJALAN)
  tanggalMulai  DateTime          @db.Date
  targetSelesai DateTime?         @db.Date
  selesaiPada   DateTime?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items OnboardingItem[]

  @@index([karyawanId, status])
  @@map("onboarding")
}

model OnboardingItem {
  id               String              @id @default(cuid())
  onboardingId     String
  onboarding       Onboarding          @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  judul            String
  kategori         KategoriOnboarding  @default(LAINNYA)
  wajib            Boolean             @default(true)
  status           StatusOnboardingItem @default(BELUM)
  catatan          String?
  diselesaikanPada DateTime?
  diverifikasiOlehId String?
  diverifikasiPada DateTime?
  urutan           Int                 @default(0)

  @@index([onboardingId, urutan])
  @@map("onboarding_item")
}

enum KategoriOnboarding {
  DOKUMEN
  AKUN
  ASET
  ORIENTASI
  LAINNYA
}

enum StatusOnboarding {
  BERJALAN
  SELESAI
  DIBATALKAN
}

enum StatusOnboardingItem {
  BELUM
  SELESAI
  TERVERIFIKASI
}

// ============================================================
// Offboarding / resign (P1-3). Alur: DIAJUKAN → MENUNGGU_APPROVAL
// (atasan → HR) → DISETUJUI → CLEARANCE → SELESAI.
// Selesai: status RESIGN + paklaring + akun dinonaktifkan.
// ============================================================

model Offboarding {
  id              String            @id @default(cuid())
  karyawanId      String
  karyawan        Karyawan          @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  alasan          String
  tanggalRencana  DateTime          @db.Date
  tanggalEfektif  DateTime?         @db.Date
  status          StatusOffboarding @default(DIAJUKAN)
  diajukanPada    DateTime?
  approvedById    String?
  approvedAt      DateTime?
  approvedNote    String?
  nomorPaklaring  String?           @unique
  selesaiPada     DateTime?
  selesaiOlehId   String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  clearance OffboardingClearance[]

  @@index([karyawanId, status])
  @@map("offboarding")
}

model OffboardingClearance {
  id               String                 @id @default(cuid())
  offboardingId    String
  offboarding      Offboarding            @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  kategori         KategoriClearance      @default(LAINNYA)
  judul            String
  picRole          String                 @default("HR")
  wajib            Boolean                @default(true)
  status           StatusClearance        @default(BELUM)
  catatan          String?
  diselesaikanOlehId String?
  diselesaikanPada DateTime?

  @@index([offboardingId])
  @@map("offboarding_clearance")
}

enum KategoriClearance {
  DOKUMEN
  AKUN
  ASET
  KEUANGAN
  LAINNYA
}

enum StatusOffboarding {
  DIAJUKAN
  MENUNGGU_APPROVAL
  DISETUJUI
  DITOLAK
  CLEARANCE
  SELESAI
  DIBATALKAN
}

enum StatusClearance {
  BELUM
  SELESAI
}

// ============================================================
// Probation review (P1-4). Alur: DRAFT → DIAJUKAN →
// MENUNGGU_APPROVAL (atasan → HR) → DISETUJUI → SELESAI.
// Finalisasi memicu: LULUS → AKTIF; PERPANJANG → review lanjutan;
// TIDAK_LULUS → DIHENTIKAN + akun nonaktif.
// ============================================================

model ProbationReview {
  id                 String           @id @default(cuid())
  karyawanId         String
  karyawan           Karyawan         @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  tanggalMulai       DateTime
  tanggalSelesai     DateTime
  status             StatusProbation  @default(DRAFT)
  hasil              HasilProbation?
  nilai              Int?
  catatan            String?
  tanggalSelesaiBaru DateTime?
  diajukanPada       DateTime?
  diputuskanOlehId   String?
  diputuskanPada     DateTime?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([karyawanId, status])
  @@map("probation_review")
}

enum StatusProbation {
  DRAFT
  DIAJUKAN
  MENUNGGU_APPROVAL
  DISETUJUI
  DITOLAK
  SELESAI
  DIBATALKAN
}

enum HasilProbation {
  LULUS
  PERPANJANG
  TIDAK_LULUS
}

// ============================================================
// Tanda tangan kontrak (e-sign sederhana). File disimpan
// via /api/files (ownerType karyawan, subfolder kontrak).
// ============================================================

model KontrakTandaTangan {
  id                 String   @id @default(cuid())
  kontrakId          String
  kontrak            KontrakKerja @relation(fields: [kontrakId], references: [id], onDelete: Cascade)
  pihak              PihakTandaTangan
  namaPenanda        String?
  fileUrl            String
  ditandatanganiPada DateTime @default(now())
  createdById        String?
  createdAt          DateTime @default(now())

  @@unique([kontrakId, pihak])
  @@map("kontrak_tanda_tangan")
}

enum PihakTandaTangan {
  HRD
  KARYAWAN
}

// ============================================================
// Surat peringatan & PHK. Eskalasi: SP1 → SP2 → SP3 → SKORSING → PHK
// (pelanggaran berat bisa langsung PHK). Berlaku 6 bulan default.
// Skorsing tanpa upah memotong gaji (pengaturan) seperti alpa.
// ============================================================

model SuratPeringatan {
  id                   String       @id @default(cuid())
  nomor                String       @unique
  karyawanId           String
  karyawan             Karyawan     @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  tingkat              TingkatSP
  judul                String
  pelanggaran          String
  pelanggaranBerat     Boolean      @default(false)
  tanggalTerbit        DateTime     @db.Date
  berlakuSampai        DateTime?    @db.Date
  tanggalSkorsingMulai DateTime?    @db.Date
  tanggalSkorsingSelesai DateTime?  @db.Date
  status               StatusSP     @default(DRAFT)
  dokumenUrl           String?
  ttdKaryawanPada      DateTime?
  ttdKaryawanNama      String?
  catatan              String?
  diterbitkanOlehId    String?
  diterbitkanPada      DateTime?
  dicabutOlehId        String?
  dicabutPada          DateTime?
  alasanCabut          String?
  createdById          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([karyawanId, status])
  @@map("surat_peringatan")
}

enum TingkatSP {
  SP1
  SP2
  SP3
  SKORSING
  PHK
}

enum StatusSP {
  DRAFT
  DITERBITKAN
  DICABUT
}

// ============================================================
// Kasbon / pinjaman karyawan (angsuran via salary run).
// DRAFT → DIAJUKAN → DISETUJUI/DITOLAK; LUNAS otomatis saat sisa 0.
// Potongan dibukukan di KasbonAngsuran agar hitung-ulang idempoten.
// ============================================================

model Kasbon {
  id               String       @id @default(cuid())
  nomor            String       @unique
  karyawanId       String
  karyawan         Karyawan     @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  nominal          Decimal      @db.Decimal(15, 2)
  tenorBulan       Int
  angsuranPerBulan Decimal      @db.Decimal(15, 2)
  sisaHutang       Decimal      @db.Decimal(15, 2)
  mulaiPotong      DateTime     @db.Date
  alasan           String
  status           StatusKasbon @default(DRAFT)
  approvedById     String?
  approvedAt       DateTime?
  catatan          String?
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  angsuran KasbonAngsuran[]

  @@index([karyawanId, status])
  @@map("kasbon")
}

enum StatusKasbon {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DIBATALKAN
  LUNAS
}

model KasbonAngsuran {
  id        String    @id @default(cuid())
  kasbonId  String
  kasbon    Kasbon    @relation(fields: [kasbonId], references: [id], onDelete: Cascade)
  runId     String
  run       SalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  periode   String
  jumlah    Decimal   @db.Decimal(15, 2)
  createdAt DateTime  @default(now())

  @@unique([kasbonId, runId])
  @@index([runId])
  @@map("kasbon_angsuran")
}

model Payslip {
  id         String    @id @default(cuid())
  nomor      String    @unique
  runId      String
  run        SalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  karyawanId String
  karyawan   Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  // Kode verifikasi slip PDF (diisi saat terbit/unduh pertama).
  kodeVerifikasi String? @unique
  createdAt  DateTime  @default(now())

  @@unique([runId, karyawanId])
  @@map("payslip")
}

// ============================================================
// DINAS / WFH — perjalanan dinas & kerja dari rumah
// ============================================================

model DinasWFH {
  id             String       @id @default(cuid())
  nomorPengajuan String       @unique
  karyawanId     String
  karyawan       Karyawan      @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  jenis          JenisDinas
  tanggalMulai   DateTime      @db.Date
  tanggalSelesai DateTime      @db.Date
  lokasi         String?
  keperluan      String?
  urlLampiran    String?
  status         StatusPengajuanKetidakhadiran @default(DRAFT)
  diajukanPada   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([karyawanId, tanggalMulai])
  @@index([status])
  @@map("dinas_wfh")
}

enum JenisDinas {
  DINAS_LUAR
  WFH
}

// ============================================================
// APPROVAL — jejak persetujuan generik
// ============================================================

model ApprovalStep {
  id                String         @id @default(cuid())
  referensiType     String
  referensiId       String
  tahap             Int            @default(1)
  approverKaryawanId String?
  approverRole      String?
  status            StatusApproval @default(MENUNGGU)
  catatan           String?
  diprosesOlehId    String?
  diprosesPada      DateTime?
  createdAt         DateTime       @default(now())

  @@index([referensiType, referensiId])
  @@map("approval_step")
}

enum StatusApproval {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

// ============================================================
// PENUGASAN JADWAL — Assign jadwal kerja/shift ke karyawan
// ============================================================

model PenugasanJadwal {
  id              Int         @id @default(autoincrement())
  karyawanId      String
  karyawan        Karyawan    @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  jadwalKerjaId   Int
  jadwalKerja     JadwalKerja @relation(fields: [jadwalKerjaId], references: [id])

  tanggalMulai    DateTime
  tanggalSelesai  DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([karyawanId, tanggalMulai])
  @@index([karyawanId])
  @@index([jadwalKerjaId])
  @@map("penugasan_jadwal")
}