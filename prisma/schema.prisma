generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// BETTER AUTH — Core tables
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          String   @default("EMPLOYEE")
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  karyawan Karyawan[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================================
// MASTER DATA WILAYAH
// ============================================================

model Provinsi {
  id   String @id
  nama String

  kota Kota[]

  @@map("provinsi")
}

model Kota {
  id         String   @id
  provinsiId String
  nama       String
  provinsi   Provinsi @relation(fields: [provinsiId], references: [id], onDelete: Cascade)

  kecamatan Kecamatan[]

  @@index([provinsiId])
  @@map("kota")
}

model Kecamatan {
  id     String @id
  kotaId String
  nama   String
  kota   Kota   @relation(fields: [kotaId], references: [id], onDelete: Cascade)

  desa Desa[]

  @@index([kotaId])
  @@map("kecamatan")
}

model Desa {
  id          String    @id
  kecamatanId String
  nama        String
  kecamatan   Kecamatan @relation(fields: [kecamatanId], references: [id], onDelete: Cascade)

  @@index([kecamatanId])
  @@map("desa")
}

// ============================================================
// COMPANY — profil perusahaan
// ============================================================

model Perusahaan {
  id          String   @id @default(cuid())
  nama        String
  logo        String?
  npwp        String?
  telepon     String?
  email       String?
  website     String?
  provinsiId  String?
  kotaId      String?
  kecamatanId String?
  desaId      String?
  alamat      String?
  kodePos     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("perusahaan")
}

// ============================================================
// UNIT ORGANISASI — struktur unit kerja yang sederhana
// ============================================================

model UnitOrganisasi {
  id       String           @id @default(cuid())
  parentId String?
  parent   UnitOrganisasi?  @relation("UnitTree", fields: [parentId], references: [id])
  children UnitOrganisasi[] @relation("UnitTree")

  nama      String
  kode      String?
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisi         Posisi[]
  posisiKaryawan PosisiKaryawan[]

  @@index([parentId])
  @@map("unit_organisasi")
}

// ============================================================
// GOLONGAN POSISI — grade posisi
// ============================================================

model GolonganPosisi {
  id        String   @id @default(cuid())
  nama      String
  kode      String?  @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisi Posisi[]

  @@map("golongan_posisi")
}

// ============================================================
// POSISI
// ============================================================

model Posisi {
  id                String           @id @default(cuid())
  unitOrganisasiId  String?
  unitOrganisasi    UnitOrganisasi?  @relation(fields: [unitOrganisasiId], references: [id])
  golonganPosisiId String?
  golonganPosisi   GolonganPosisi? @relation(fields: [golonganPosisiId], references: [id])

  nama      String
  kode      String?  @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisiKaryawan PosisiKaryawan[]

  @@map("posisi")
}

// ============================================================
// LOKASI KERJA — cabang / kantor / lokasi kerja
// ============================================================

model LokasiKerja {
  id        String   @id @default(cuid())
  nama      String
  kode      String?
  alamat    String?
  kota      String?
  provinsi  String?
  kodePos   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posisiKaryawan PosisiKaryawan[]

  @@map("lokasi_kerja")
}

// ============================================================
// KARYAWAN — Data utama karyawan
// ============================================================

model Karyawan {
  id            String  @id @default(cuid())
  userId        String?
  user          User?   @relation(fields: [userId], references: [id])
  nomorKaryawan String

  namaLengkap  String
  gender       JenisKelamin
  tanggalLahir DateTime?
  nik          String?
  npwp         String?
  telepon      String?
  email        String?
  alamat       String?

  status         StatusKaryawan @default(AKTIF)
  tanggalMasuk   DateTime
  tanggalResign  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kontrakKerja       KontrakKerja[]
  posisiKaryawan    PosisiKaryawan[]
  keluargaKaryawan   KeluargaKaryawan[]
  pendidikanKaryawan PendidikanKaryawan[]
  riwayatPekerjaan   RiwayatPekerjaan[]
  dokumenKaryawan    DokumenKaryawan[]

  @@unique([nomorKaryawan])
  @@index([status])
  @@map("karyawan")
}

// ============================================================
// KONTRAK KERJA — Histori hubungan kerja employee
// ============================================================

model KontrakKerja {
  id         String   @id @default(cuid())
  karyawanId String
  karyawan   Karyawan @relation(fields: [karyawanId],references: [id], onDelete: Cascade)
  nomorKontrak String       @unique
  jenisKontrak JenisKontrak
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  status StatusKontrak @default(DRAFT)
  gajiPokok Decimal? @db.Decimal(15, 2)
  catatan    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([karyawanId])
  @@index([karyawanId, status])
  @@index([tanggalMulai])
  @@index([tanggalSelesai])

  @@map("kontrak_kerja")
}


// ============================================================
// ENUM — JENIS KONTRAK
// ============================================================

enum JenisKontrak {
  PKWT
  PKWTT
  MAGANG
  FREELANCE
  OUTSOURCING
}


// ============================================================
// ENUM — STATUS KONTRAK
// ============================================================

enum StatusKontrak {
  DRAFT
  AKTIF
  AKAN_BERAKHIR
  BERAKHIR
  DIBATALKAN
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusKaryawan {
  AKTIF
  TIDAK_AKTIF
  PROBASI
  RESIGN
  DIHENTIKAN
  PENSIUN
}



// ============================================================
// POSISI KARYAWAN — riwayat posisi yang pernah/terpilih
// ============================================================

model PosisiKaryawan {
  id               String          @id @default(cuid())
  karyawanId       String
  karyawan         Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  unitOrganisasiId String?
  unitOrganisasi   UnitOrganisasi? @relation(fields: [unitOrganisasiId], references: [id])
  posisiId        String?
  posisi          Posisi?        @relation(fields: [posisiId], references: [id])
  lokasiKerjaId    String?
  lokasiKerja      LokasiKerja?    @relation(fields: [lokasiKerjaId], references: [id])

  isPrimary       Boolean   @default(true)
  isCurrent       Boolean   @default(true)
  tanggalEfektif  DateTime
  tanggalBerakhir DateTime?
  catatan         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([karyawanId, isCurrent])
  @@map("posisi_karyawan")
}

// ============================================================
// KELUARGA KARYAWAN — Data keluarga & ahli waris
// ============================================================

model KeluargaKaryawan {
  id           String           @id @default(cuid())
  karyawanId   String
  karyawan     Karyawan         @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  nama         String
  hubungan     HubunganKeluarga
  gender       JenisKelamin
  tanggalLahir DateTime?
  nik          String?
  pekerjaan    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("keluarga_karyawan")
}

enum HubunganKeluarga {
  PASANGAN
  ANAK
  ORANG_TUA
  SAUDARA
  LAINNYA
}

// ============================================================
// PENDIDIKAN KARYAWAN
// ============================================================

model PendidikanKaryawan {
  id          String          @id @default(cuid())
  karyawanId  String
  karyawan    Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  gelar       GelarPendidikan
  institusi   String
  jurusan     String?
  tahunMulai  Int?
  tahunLulus  Int?
  ipk         Float?
  isHighest   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("pendidikan_karyawan")
}

enum GelarPendidikan {
  SD
  SMP
  SMA_SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
  LAINNYA
}

// ============================================================
// RIWAYAT PEKERJAAN — Riwayat pekerjaan sebelumnya
// ============================================================

model RiwayatPekerjaan {
  id               String    @id @default(cuid())
  karyawanId       String
  karyawan         Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  namaPerusahaan   String
  posisi          String?
  tanggalMulai     DateTime?
  tanggalSelesai   DateTime?
  gajiTerakhir     Decimal?  @db.Decimal(15, 2)
  alasanKeluar     String?
  teleponReferensi String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("riwayat_pekerjaan")
}

// ============================================================
// DOKUMEN KARYAWAN
// ============================================================

model DokumenKaryawan {
  id                String       @id @default(cuid())
  karyawanId        String
  karyawan          Karyawan     @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  jenisDokumen      JenisDokumen
  nama              String
  urlFile           String
  ukuranFile        BigInt?
  tipeFile          String?
  tanggalKadaluarsa DateTime?
  catatan           String?
  tanggalUnggah     DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("dokumen_karyawan")
}

enum JenisDokumen {
  KTP
  NPWP
  IJAZAH
  TRANSKRIP
  PAKLARING
  SERTIFIKAT
  KONTRAK_KERJA
  FOTO
  KARTU_KELUARGA
  BPJS_KESEHATAN
  BPJS_KETENAGAKERJAAN
  CV
  LAINNYA
}
